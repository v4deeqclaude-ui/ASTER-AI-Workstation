<Window x:Class="ASTER.Workstation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASTER AI Workstation 0.1" Height="780" Width="1260"
        MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#14181E" BorderBrush="#262D37" BorderThickness="0,0,1,0">
            <DockPanel Margin="17,20,17,16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ASTER" FontSize="27" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="AI WORKSTATION" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="1,0,0,27" />
                    <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="7,0,0,9" />
                    <Button Content="⌂   Главная" HorizontalContentAlignment="Left" Background="#29313D" BorderThickness="0" Margin="0,0,0,5" Click="Home_Click" />
                    <Button Content="▣   Проекты" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,0,0,5" Click="Projects_Click" />
                    <Button Content="◇   Приложения" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,0,0,5" Click="Applications_Click" />
                    <Button Content="◷   История" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,0,0,5" Click="History_Click" />
                    <Button Content="✦   AI-ассистент" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,0,0,5" Click="Chat_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#2A313B" Margin="0,0,0,13" />
                    <Button Content="⚙   Настройки" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="Settings_Click" />
                    <TextBlock Text="VERSION 0.1.0 · LOCAL" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="8,18,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,25,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Главная" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Твоя рабочая среда для создания игр." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1D2925" BorderBrush="#315445" BorderThickness="1" CornerRadius="20" Padding="11,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#67C49A" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="ЛОКАЛЬНЫЙ РЕЖИМ" FontSize="9" Foreground="#9DD8B9" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="#1C222B" BorderBrush="#303946" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,0,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ТВОИ ПРОЕКТЫ" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="Всё необходимое для разработки — в одном месте." FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="Добавь папку существующей игры или создай отдельное рабочее пространство." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="＋  Добавить проект" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AccentBrush}" Foreground="#17191D" BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" Click="AddProject_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#2A323D" BorderThickness="1" CornerRadius="11" Padding="13">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                            <Grid>
                                <TextBlock Text="МОИ ПРОЕКТЫ" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ProjectCountText" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            </Grid>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                            <Button Content="Обновить" Padding="10,7" Click="Refresh_Click" />
                            <Button Content="Убрать из списка" Padding="10,7" Margin="7,0,0,0" Click="RemoveProject_Click" />
                        </StackPanel>
                        <ListBox x:Name="ProjectsList" SelectionChanged="ProjectsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RootPath}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#2A323D" BorderThickness="1" CornerRadius="11" Padding="17">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="SelectedProjectName" Text="Проект не выбран" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectedProjectPath" Text="Добавь проект, чтобы просмотреть его папки и файлы." Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Height="1" Background="#2A323D" Margin="0,15,0,12" />
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="СОДЕРЖИМОЕ ПАПКИ" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,9" />
                            <TreeView x:Name="FilesTree" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" />
                            <StackPanel x:Name="EmptyProjectPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                                <TextBlock Text="Выбери проект слева" FontSize="15" HorizontalAlignment="Center" />
                                <TextBlock Text="ASTER покажет структуру его папок." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="1,14,1,0">
                <TextBlock x:Name="StatusText" Text="Готово. Данные сохраняются на этом компьютере." FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button Content="Создать резервную копию" HorizontalAlignment="Right" Padding="11,6" FontSize="10" Click="Backup_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
