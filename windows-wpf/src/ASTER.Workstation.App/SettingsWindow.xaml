<Window x:Class="ASTER.Workstation.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASTER — настройки" Height="760" Width="720"
        MinHeight="650" MinWidth="650" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="НАСТРОЙКИ ASTER" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        <Grid Grid.Row="1" Margin="0,5,0,16">
            <TextBlock Text="Локальный ИИ и подключения" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="⌨  Командная строка" Click="OpenTerminal_Click" HorizontalAlignment="Right" Padding="11,6" VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="#24516A" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="OLLAMA · ЛОКАЛЬНАЯ МОДЕЛЬ" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="АДРЕС ЛОКАЛЬНОГО СЕРВЕРА" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBox x:Name="OllamaEndpointBox" Text="http://localhost:11434" Height="34" Padding="8" Margin="0,5,0,12"
                         Background="#102235" Foreground="{StaticResource TextBrush}" BorderBrush="#24516A"/>
                <TextBlock Text="НАЗВАНИЕ МОДЕЛИ" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                <DockPanel Margin="0,5,0,0">
                    <Button x:Name="CheckOllamaButton" Content="Проверить Ollama" Click="CheckOllama_Click" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6"/>
                    <TextBox x:Name="OllamaModelBox" Text="qwen3:1.7b" Height="34" Padding="8"
                             Background="#102235" Foreground="{StaticResource TextBrush}" BorderBrush="#24516A"/>
                </DockPanel>
                <TextBlock x:Name="LocalAiStatusText" Text="Локальный ИИ ещё не проверен." TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                <Button Content="Сохранить настройки Ollama" Click="SaveAiSettings_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                        Padding="14,7" Background="{StaticResource AccentBrush}" Foreground="#17191D"
                        BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="#24516A" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ASTER CONNECT · ИНТЕГРАЦИИ" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="Локальный коннектор" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,3"/>
                <TextBlock Text="ASTER запускает встроенный сервер в фоне. Отдельно открывать EXE или устанавливать .NET Runtime не потребуется."
                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="ConnectStatusText" Text="Состояние коннектора ещё не проверено."
                           TextWrapping="Wrap" FontSize="11" Margin="0,10,0,10"/>
                <WrapPanel>
                    <Button x:Name="StartConnectButton" Content="Запустить коннектор" Click="StartConnect_Click"
                            Padding="13,7" Margin="0,0,8,0" Background="{StaticResource AccentBrush}"
                            Foreground="#17191D" BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    <Button x:Name="CheckConnectButton" Content="Проверить" Click="CheckConnect_Click" Padding="13,7" Margin="0,0,8,0"/>
                    <Button x:Name="StopConnectButton" Content="Остановить" Click="StopConnect_Click" Padding="13,7"/>
                </WrapPanel>
                <TextBlock Text="GitHub: локальный коннектор — инфраструктура. Для реального доступа к репозиториям ещё нужны настройка GitHub App, публичный HTTPS-сервер и защищённый обмен installation token."
                           TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="4" Background="#101F2D" BorderBrush="#24516A" BorderThickness="1" CornerRadius="14" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="ЖУРНАЛ ASTER" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Очистить" Click="ClearConsole_Click" DockPanel.Dock="Right" Padding="8,3" FontSize="10"/>
                </DockPanel>
                <TextBox x:Name="DiagnosticConsole" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="#090F18" Foreground="#A8F1FF" BorderBrush="#273442"
                         FontFamily="Consolas" FontSize="11" Padding="8"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="5" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="10"
                   VerticalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <Button Grid.Row="5" Content="Закрыть" Click="Close_Click" HorizontalAlignment="Right" Padding="14,6"/>
    </Grid>
</Window>