<Window x:Class="ASTER.Workstation.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASTER — настройки AI" Height="760" Width="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ПОДКЛЮЧЕНИЕ AI" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Настройки провайдера" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,16"/>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="#394453" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ВХОД ЧЕРЕЗ CHATGPT" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="Авторизация в браузере. ASTER не просит пароль и хранит сессию с защитой Windows DPAPI." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/>
                <TextBlock Text="ПРОКСИ ДЛЯ ПОДКЛЮЧЕНИЯ" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <Button Content="Сохранить" Click="SaveProxy_Click" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="9,5"/>
                    <TextBox x:Name="ProxyBox" Height="30" Padding="7" Background="#202630" Foreground="{StaticResource TextBrush}" BorderBrush="#394453" FontFamily="Consolas" Text="http://127.0.0.1:10809"/>
                </DockPanel>
                <TextBlock Text="Укажи HTTP-прокси, например http://127.0.0.1:10809, или direct для прямого подключения. Изменение применяется после перезапуска ASTER." TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <TextBlock x:Name="ChatGPTStatusText" Text="Проверяем подключение…" FontSize="11" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SignInButton" Content="Continue with ChatGPT" Click="SignIn_Click" Background="{StaticResource AccentBrush}" Foreground="#17191D" BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    <Button x:Name="DisconnectButton" Content="Отключить" Click="Disconnect_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="#394453" BorderThickness="1" CornerRadius="9" Padding="14">
            <StackPanel>
                <TextBlock Text="OPENAI API KEY — АЛЬТЕРНАТИВА" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="Этот способ подключения остаётся отдельным и не включается автоматически вместо ChatGPT." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,8"/>
                <PasswordBox x:Name="ApiKeyBox" Height="36" Padding="9" Background="#202630" Foreground="{StaticResource TextBrush}" BorderBrush="#394453" FontSize="13"/>
                <DockPanel Margin="0,7,0,0">
                    <Button Content="Удалить сохранённый ключ" Click="DeleteApiKey_Click" DockPanel.Dock="Right" Padding="8,4" FontSize="10"/>
                    <TextBlock x:Name="KeyStatusText" Text="Ключ не сохранён." FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="4" Background="#111820" BorderBrush="#394453" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="КОНСОЛЬ ДИАГНОСТИКИ" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Очистить" Click="ClearConsole_Click" DockPanel.Dock="Right" Padding="8,3" FontSize="10"/>
                </DockPanel>
                <TextBox x:Name="DiagnosticConsole" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="#0B1016" Foreground="#B8D7C2" BorderBrush="#273442"
                         FontFamily="Consolas" FontSize="11" Padding="8"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="5" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Закрыть" Click="Close_Click" Margin="0,0,8,0"/>
            <Button Content="Сохранить API-ключ" Background="{StaticResource AccentBrush}" Foreground="#17191D"
                    BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
