<Window x:Class="ASTER.Workstation.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASTER — настройки AI" Height="390" Width="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ПОДКЛЮЧЕНИЕ AI" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Настройки провайдера" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,18"/>
        <TextBlock Grid.Row="2" Text="Провайдер: OpenAI · API: Responses API" FontSize="13" Margin="0,0,0,7"/>
        <StackPanel Grid.Row="3">
            <TextBlock Text="API-ключ OpenAI" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6"/>
            <PasswordBox x:Name="ApiKeyBox" Height="38" Padding="10" Background="#202630"
                         Foreground="{StaticResource TextBrush}" BorderBrush="#394453" FontSize="13"/>
            <TextBlock x:Name="KeyStatusText" Text="Ключ не сохранён." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
            <TextBlock Text="Ключ хранится в защищённом хранилище Windows, а не в файлах проекта." TextWrapping="Wrap"
                       FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
            <TextBlock Text="Модель чата: gpt-4.1-mini" FontSize="11" Margin="0,12,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Закрыть" Click="Close_Click" Margin="0,0,8,0"/>
            <Button Content="Сохранить ключ" Background="{StaticResource AccentBrush}" Foreground="#17191D"
                    BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>