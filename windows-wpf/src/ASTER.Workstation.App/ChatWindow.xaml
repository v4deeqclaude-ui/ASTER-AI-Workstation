<UserControl x:Class="ASTER.Workstation.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#071321" Foreground="#EAF7FC">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="30" Margin="0,0,0,6">
            <Button x:Name="CloseWorkspaceButton" Content="×" Width="30" Height="30"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0"
                    FontSize="20" FontWeight="Light" Background="#10273A"
                    Foreground="#A8F1FF" BorderBrush="#28617D"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="CloseWorkspace_Click" ToolTip="Закрыть раздел"/>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Border Background="#061522" BorderBrush="#17415D"
                    BorderThickness="1" CornerRadius="14" Opacity="0.42"/>
            <Image x:Name="HeroImage" Width="320" Height="480"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Stretch="Fill" IsHitTestVisible="False"
                   Opacity="0.36" Margin="0,0,8,0"
                   RenderOptions.BitmapScalingMode="Fant"/>
            <ListBox x:Name="MessagesList"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single" Margin="16,12,16,12">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#6610283A" BorderBrush="#661C5877"
                                BorderThickness="1" CornerRadius="11"
                                Padding="12" Margin="0,7,0,7"
                                HorizontalAlignment="Left" MaxWidth="820">
                            <StackPanel>
                                <TextBlock Text="{Binding Author}" FontSize="10"
                                           Foreground="#9BBCCB" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                           FontSize="14" LineHeight="21" Margin="0,4,0,0"
                                           Foreground="#EAF7FC"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Visibility="Collapsed"/>
        <TextBlock x:Name="AttachmentsText" Grid.Row="2" Text="" FontSize="10"
                   Foreground="#91AFC4" TextTrimming="CharacterEllipsis"
                   Margin="4,8,4,6"/>

        <StackPanel Grid.Row="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AttachButton" Grid.Column="0" Width="42" Height="44"
                        MinWidth="42" MinHeight="44" Padding="0" Margin="0,0,8,0"
                        Background="#12344B" Foreground="#8DEAFF" BorderBrush="#23779D"
                        Click="Attach_Click" PreviewMouseRightButtonDown="AttachButton_Clear"
                        ToolTip="Добавить файлы и папки">
                    <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="16" Height="2" Background="#8DEAFF" CornerRadius="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="2" Height="16" Background="#8DEAFF" CornerRadius="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Border Grid.Column="1" Background="#0E2639" BorderBrush="#1E7196"
                        BorderThickness="1" CornerRadius="14" Padding="5">
                    <TextBox x:Name="MessageInput" MinHeight="42" MaxHeight="110"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="10,7"
                             Background="Transparent" Foreground="#EAF7FC"
                             BorderThickness="0" FontSize="13"
                             VerticalContentAlignment="Center"
                             KeyDown="MessageInput_KeyDown"/>
                </Border>
                <Button x:Name="SendButton" Grid.Column="2" Content="➤" FontSize="20"
                        Width="44" Height="44" Margin="8,0,0,0" Padding="0"
                        Background="#0E9FCB" Foreground="#FFFFFF"
                        BorderBrush="#38D5FF" FontWeight="SemiBold" Click="Send_Click"
                        ToolTip="Отправить сообщение"/>
            </Grid>
            <UniformGrid Columns="5" Margin="0,9,0,0">
                <Button Content="♧&#10;Анализ" Tag="Проанализируй мою задачу и предложи план действий." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="⚒&#10;Создание" Tag="Помоги создать новый проект. Предложи структуру и этапы." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="◇&#10;Помощь" Tag="Помоги мне разобраться с задачей пошагово." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="✧&#10;Идеи" Tag="Предложи несколько интересных идей для моей задачи." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="⌘&#10;Код" Tag="Помоги написать или объяснить код. Сначала уточни задачу." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>