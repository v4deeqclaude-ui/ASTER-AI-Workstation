<UserControl x:Class="ASTER.Workstation.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#090F18" Foreground="#EAF7FC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock x:Name="SectionEyebrow" Text="ASTER AI WORKSTATION" FontSize="10"
                           Foreground="#16C8F5" FontWeight="SemiBold"/>
                <TextBlock x:Name="SectionTitleText" Text="ИИ-чат" FontSize="24"
                           FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock x:Name="SectionSubtitleText"
                           Text="Локальный ИИ Ollama · переписка хранится на этом компьютере"
                           FontSize="11" Foreground="#91A7B5" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="CloseWorkspaceButton" Content="×" Width="36" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0"
                    FontSize="22" FontWeight="Light" Background="#12283A"
                    Foreground="#A8F1FF" BorderBrush="#24516A"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="CloseWorkspace_Click" ToolTip="Закрыть раздел"/>
        </Grid>

        <Grid Grid.Row="1">
            <Canvas Width="360" Height="420" HorizontalAlignment="Center"
                    VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.095">
                <Ellipse Canvas.Left="42" Canvas.Top="26" Width="276" Height="276" Stroke="#16C8F5" StrokeThickness="2" StrokeDashArray="2 8"/>
                <Ellipse Canvas.Left="62" Canvas.Top="46" Width="236" Height="236" Stroke="#A8F1FF" StrokeThickness="1"/>
                <Path Data="M 180,0 L 180,28 M 174,8 L 186,8" Stroke="#16C8F5" StrokeThickness="3" Fill="Transparent"/>
                <Ellipse Canvas.Left="169" Canvas.Top="0" Width="22" Height="22" Stroke="#A8F1FF" StrokeThickness="3" Fill="#102A39"/>
                <Polygon Points="111,65 139,43 221,43 249,65 263,112 248,153 220,177 140,177 112,153 97,112"
                         Fill="#102A39" Stroke="#16C8F5" StrokeThickness="5"/>
                <Polygon Points="126,83 145,69 215,69 234,83 243,111 231,139 211,154 149,154 129,139 117,111"
                         Fill="#0B1C29" Stroke="#A8F1FF" StrokeThickness="2"/>
                <Path Data="M 134,111 L 158,111 L 166,120 L 158,129 L 134,129 Z" Fill="#16C8F5" Stroke="#A8F1FF" StrokeThickness="1"/>
                <Path Data="M 226,111 L 202,111 L 194,120 L 202,129 L 226,129 Z" Fill="#16C8F5" Stroke="#A8F1FF" StrokeThickness="1"/>
                <Path Data="M 160,143 L 180,150 L 200,143" Stroke="#A8F1FF" StrokeThickness="3" Fill="Transparent"/>
                <Path Data="M 99,91 L 79,106 L 88,137 L 107,145 M 261,91 L 281,106 L 272,137 L 253,145"
                      Stroke="#16C8F5" StrokeThickness="6" Fill="Transparent"/>
                <Path Data="M 180,177 L 180,193" Stroke="#16C8F5" StrokeThickness="5" Fill="Transparent"/>
                <Polygon Points="119,194 145,181 215,181 241,194 258,279 236,307 124,307 102,279"
                         Fill="#102A39" Stroke="#16C8F5" StrokeThickness="5"/>
                <Path Data="M 139,215 L 221,215 M 130,235 L 230,235 M 140,255 L 220,255"
                      Stroke="#A8F1FF" StrokeThickness="3" Fill="Transparent"/>
                <Polygon Points="180,220 197,239 180,258 163,239" Fill="#16C8F5" Stroke="#A8F1FF" StrokeThickness="2"/>
                <Ellipse Canvas.Left="171" Canvas.Top="230" Width="18" Height="18" Stroke="#E5FBFF" StrokeThickness="2"/>
                <Path Data="M 111,204 L 79,220 L 64,275 L 83,285 L 109,250 M 249,204 L 281,220 L 296,275 L 277,285 L 251,250"
                      Stroke="#16C8F5" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                <Path Data="M 141,307 L 130,365 L 111,384 M 219,307 L 230,365 L 249,384"
                      Stroke="#16C8F5" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                <Path Data="M 95,390 L 128,390 M 232,390 L 265,390" Stroke="#A8F1FF" StrokeThickness="5" Fill="Transparent"/>
                <Path Data="M 49,174 L 68,174 M 292,174 L 311,174 M 180,318 L 180,344"
                      Stroke="#A8F1FF" StrokeThickness="2" Fill="Transparent"/>
            </Canvas>

            <ListBox x:Name="MessagesList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,11,0,11" MaxWidth="900"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Author}" FontSize="10"
                                       Foreground="#16C8F5" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                       FontSize="14" LineHeight="21" Margin="0,5,0,0"
                                       Foreground="#EAF2F7"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Text="Готов к работе с локальной моделью."
                   FontSize="10" Foreground="#91A7B5" Margin="2,10,2,8"/>

        <TextBlock x:Name="AttachmentsText" Grid.Row="3" Text="" FontSize="10" Foreground="#91A7B5" TextTrimming="CharacterEllipsis" Margin="2,0,2,7"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="AttachButton" Grid.Column="0" Content="＋" FontSize="20" Width="44" Margin="0,0,8,0"
                    Background="#173044" Foreground="#A8F1FF" BorderBrush="#24516A" Click="Attach_Click" PreviewMouseRightButtonDown="AttachButton_Clear" ToolTip="Добавить файлы и папки; правый клик — очистить вложения"/>
            <Border Grid.Column="1" Background="#102235" BorderBrush="#24516A"
                    BorderThickness="1" CornerRadius="14" Padding="5">
                <TextBox x:Name="MessageInput" MinHeight="48" MaxHeight="140"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="10,8"
                         Background="Transparent" Foreground="#EAF7FC"
                         BorderThickness="0" FontSize="13"
                         VerticalContentAlignment="Center"
                         KeyDown="MessageInput_KeyDown"/>
            </Border>
            <Button x:Name="SendButton" Grid.Column="2" Content="Отправить"
                    Margin="10,0,0,0" Padding="18,10"
                    Background="#16C8F5" Foreground="#06131C"
                    BorderBrush="#16C8F5" FontWeight="SemiBold"
                    Click="Send_Click"/>
        </Grid>
    </Grid>
</UserControl>