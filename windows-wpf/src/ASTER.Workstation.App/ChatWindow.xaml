<UserControl x:Class="ASTER.Workstation.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#071321" Foreground="#EAF7FC">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="30" Margin="0,0,0,6">
            <Button x:Name="CloseWorkspaceButton" Content="×" Width="30" Height="30"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0"
                    FontSize="20" FontWeight="Light" Background="#10273A"
                    Foreground="#A8F1FF" BorderBrush="#28617D"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="CloseWorkspace_Click" ToolTip="Закрыть раздел"/>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Border Background="#061522" BorderBrush="#17415D"
                    BorderThickness="1" CornerRadius="14" Opacity="0.42"/>
            <ListBox x:Name="MessagesList"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single" Margin="16,12,16,12">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,10,0,10"
                                    HorizontalAlignment="Left" MaxWidth="820">
                            <TextBlock Text="{Binding Author}" FontSize="10"
                                       Foreground="#9BBCCB" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                       FontSize="14" LineHeight="21" Margin="0,3,0,0"
                                       Foreground="#EAF7FC"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Visibility="Collapsed"/>
        <TextBlock x:Name="AttachmentsText" Grid.Row="2" Text="" FontSize="10"
                   Foreground="#91AFC4" TextTrimming="CharacterEllipsis"
                   Margin="4,8,4,6"/>

        <StackPanel Grid.Row="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AttachButton" Grid.Column="0" Width="42" Height="44"
                        MinWidth="42" MinHeight="44" Padding="0" Margin="0,0,8,0"
                        Background="#12344B" Foreground="#8DEAFF" BorderBrush="#23779D"
                        Click="Attach_Click" PreviewMouseRightButtonDown="AttachButton_Clear"
                        ToolTip="Добавить файлы и папки">
                    <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="16" Height="2" Background="#8DEAFF" CornerRadius="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="2" Height="16" Background="#8DEAFF" CornerRadius="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <Popup x:Name="AddPopup" PlacementTarget="{Binding ElementName=AttachButton}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade" VerticalOffset="-8">
                    <Border Width="390" Background="#0B1B2B" BorderBrush="#168AB5"
                            BorderThickness="1" CornerRadius="14" Padding="12">
                        <StackPanel>
                            <TextBlock Text="ДОБАВИТЬ В ASTER" Foreground="#16C8F5"
                                       FontSize="10" FontWeight="SemiBold" Margin="4,2,4,10"/>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Button Content="Приложения" Tag="apps" Click="AddPopupTab_Click"
                                        Margin="3" Padding="10,8" Background="#16445B"
                                        Foreground="#A8F1FF" BorderBrush="#16C8F5"/>
                                <Button Content="Файлы и материалы" Tag="files" Click="AddPopupTab_Click"
                                        Margin="3" Padding="10,8" Background="#142A3A"
                                        Foreground="#C8E5F0" BorderBrush="#29495D"/>
                            </UniformGrid>
                            <UniformGrid x:Name="IntegrationIconsPanel" Columns="1">
                                <Button Tag="GitHub" Click="Integration_Click" Margin="4" Padding="8"
                                        Background="#12283B" Foreground="#EAF7FC" BorderBrush="#24516A">
                                    <StackPanel><TextBlock Text="●" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="GitHub" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="Подключить репозитории" FontSize="10" Foreground="#91A7B5" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                            </UniformGrid>
                            <StackPanel x:Name="AttachmentOptionsPanel" Visibility="Collapsed">
                                <Button Content="📎  Файлы" Click="PopupAddFiles_Click" Margin="3" Padding="9" Background="#12283B" Foreground="#EAF7FC" BorderBrush="#24516A"/>
                                <Button Content="🖼  Изображения" Click="PopupAddImages_Click" Margin="3" Padding="9" Background="#12283B" Foreground="#EAF7FC" BorderBrush="#24516A"/>
                                <Button Content="💻  Исходный код" Click="PopupAddCode_Click" Margin="3" Padding="9" Background="#12283B" Foreground="#EAF7FC" BorderBrush="#24516A"/>
                                <Button Content="📁  Папка" Click="PopupAddFolder_Click" Margin="3" Padding="9" Background="#12283B" Foreground="#EAF7FC" BorderBrush="#24516A"/>
                                <Button Content="Очистить вложения" Click="PopupClearAttachments_Click" Margin="3" Padding="9" Background="#12283B" Foreground="#EAF7FC" BorderBrush="#24516A"/>
                            </StackPanel>
                            <TextBlock Text="Выбери приложение, чтобы открыть его настройки в каталоге Plugin."
                                       Foreground="#91A7B5" FontSize="10" TextWrapping="Wrap" Margin="4,9,4,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Border Grid.Column="1" Background="#0E2639" BorderBrush="#1E7196"
                        BorderThickness="1" CornerRadius="14" Padding="5">
                    <TextBox x:Name="MessageInput" MinHeight="42" MaxHeight="110"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="10,7"
                             Background="Transparent" Foreground="#EAF7FC"
                             BorderThickness="0" FontSize="13"
                             VerticalContentAlignment="Center"
                             KeyDown="MessageInput_KeyDown"/>
                </Border>
                <Button x:Name="SendButton" Grid.Column="2" Content="➤" FontSize="20"
                        Width="44" Height="44" Margin="8,0,0,0" Padding="0"
                        Background="#0E9FCB" Foreground="#FFFFFF"
                        BorderBrush="#38D5FF" FontWeight="SemiBold" Click="Send_Click"
                        ToolTip="Отправить сообщение"/>
            </Grid>
            <UniformGrid Columns="5" Margin="0,9,0,0">
                <Button Content="♧&#10;Анализ" Tag="Проанализируй мою задачу и предложи план действий." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="⚒&#10;Создание" Tag="Помоги создать новый проект. Предложи структуру и этапы." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="◇&#10;Помощь" Tag="Помоги мне разобраться с задачей пошагово." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="✧&#10;Идеи" Tag="Предложи несколько интересных идей для моей задачи." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="⌘&#10;Код" Tag="Помоги написать или объяснить код. Сначала уточни задачу." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>