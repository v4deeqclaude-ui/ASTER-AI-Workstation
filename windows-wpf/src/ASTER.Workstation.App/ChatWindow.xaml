<UserControl x:Class="ASTER.Workstation.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#071321" Foreground="#EAF7FC">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock x:Name="SectionEyebrow" Text="✦ ASTER AI WORKSTATION" FontSize="10"
                           Foreground="#55D8FF" FontWeight="SemiBold" />
                <TextBlock x:Name="SectionTitleText" Text="Главная" FontSize="22"
                           FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock x:Name="SectionSubtitleText"
                           Text="Локальный ИИ Ollama · переписка хранится на этом компьютере"
                           FontSize="10" Foreground="#91AFC4" Margin="0,3,0,0"/>
            </StackPanel>
            <Button x:Name="CloseWorkspaceButton" Content="×" Width="32" Height="32"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0"
                    FontSize="21" FontWeight="Light" Background="#10273A"
                    Foreground="#A8F1FF" BorderBrush="#28617D"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="CloseWorkspace_Click" ToolTip="Закрыть раздел"/>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Background="#061522" BorderBrush="#17415D"
                    BorderThickness="1" CornerRadius="14" Opacity="0.52"/>
            <Canvas Grid.Column="1" Width="460" Height="560" HorizontalAlignment="Right"
                    VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.98">
                <Ellipse Canvas.Left="42" Canvas.Top="34" Width="390" Height="390"
                         Stroke="#126A9B" StrokeThickness="1.5" StrokeDashArray="2 7" Opacity="0.8"/>
                <Ellipse Canvas.Left="70" Canvas.Top="62" Width="335" Height="335"
                         Stroke="#1B9ED0" StrokeThickness="1" Opacity="0.7"/>
                <Ellipse Canvas.Left="104" Canvas.Top="96" Width="270" Height="270"
                         Stroke="#67DFFF" StrokeThickness="0.8" Opacity="0.4"/>
                <Path Data="M 0,155 C 48,98 88,74 140,60" Stroke="#1A82B7" StrokeThickness="2" Fill="Transparent"/>
                <Path Data="M 360,60 C 410,88 445,120 460,174" Stroke="#1A82B7" StrokeThickness="2" Fill="Transparent"/>

                <!-- Андроид-девушка: светлые волосы, лицо, кибернетические детали и броня -->
                <Path Data="M 190,88 C 128,68 96,126 105,207 C 110,253 91,286 77,321 C 105,306 123,289 136,258 L 144,190 Z"
                      Fill="#102E47" Stroke="#2D9CCB" StrokeThickness="3"/>
                <Path Data="M 269,87 C 331,78 356,128 343,204 C 336,251 363,286 381,319 C 346,305 322,282 309,248 L 302,181 Z"
                      Fill="#102E47" Stroke="#2D9CCB" StrokeThickness="3"/>
                <Path Data="M 166,91 C 187,61 244,54 282,82 C 310,104 316,153 303,203 C 292,249 271,279 230,286 C 185,278 157,245 146,202 C 133,151 140,113 166,91 Z"
                      Fill="#D4E8F4" Stroke="#67DFFF" StrokeThickness="3"/>
                <Path Data="M 146,149 C 132,95 167,52 223,47 C 280,43 319,84 310,146 C 294,119 277,104 257,91 C 229,111 195,119 146,149 Z"
                      Fill="#B5D8E9" Stroke="#3B9CC7" StrokeThickness="4"/>
                <Path Data="M 148,139 C 130,186 144,239 170,269 C 142,260 119,229 116,187 C 109,130 128,80 169,59"
                      Stroke="#E7F6FF" StrokeThickness="8" Fill="Transparent" Opacity="0.85"/>
                <Path Data="M 289,124 C 313,175 300,234 273,269" Stroke="#E7F6FF" StrokeThickness="7" Fill="Transparent" Opacity="0.8"/>
                <Path Data="M 177,174 Q 198,160 215,174" Stroke="#153E5B" StrokeThickness="5" Fill="Transparent"/>
                <Path Data="M 240,174 Q 259,160 278,174" Stroke="#153E5B" StrokeThickness="5" Fill="Transparent"/>
                <Ellipse Canvas.Left="187" Canvas.Top="174" Width="18" Height="10" Fill="#19BFF2"/>
                <Ellipse Canvas.Left="249" Canvas.Top="174" Width="18" Height="10" Fill="#19BFF2"/>
                <Ellipse Canvas.Left="192" Canvas.Top="177" Width="5" Height="5" Fill="#E9FCFF"/>
                <Ellipse Canvas.Left="254" Canvas.Top="177" Width="5" Height="5" Fill="#E9FCFF"/>
                <Path Data="M 227,181 L 216,212 L 230,218" Stroke="#7BB8D1" StrokeThickness="2" Fill="Transparent"/>
                <Path Data="M 202,238 Q 227,251 252,237" Stroke="#2D7598" StrokeThickness="3" Fill="Transparent"/>
                <Path Data="M 151,161 L 132,185 L 145,221 L 164,232" Stroke="#26BFF0" StrokeThickness="4" Fill="Transparent"/>
                <Ellipse Canvas.Left="292" Canvas.Top="142" Width="70" Height="70" Fill="#0A2032" Stroke="#18BDF1" StrokeThickness="7"/>
                <Ellipse Canvas.Left="306" Canvas.Top="156" Width="42" Height="42" Fill="#123D5A" Stroke="#9DEEFF" StrokeThickness="2"/>
                <Ellipse Canvas.Left="319" Canvas.Top="169" Width="16" Height="16" Fill="#20C9F8"/>
                <Path Data="M 176,276 L 169,310 L 122,348 L 102,465 L 348,465 L 329,348 L 278,310 L 270,276"
                      Fill="#0B263B" Stroke="#2D9CCB" StrokeThickness="4"/>
                <Path Data="M 169,310 L 223,344 L 278,310 M 143,368 L 223,392 L 307,368"
                      Stroke="#63DDFB" StrokeThickness="3" Fill="Transparent"/>
                <Path Data="M 223,342 L 246,369 L 223,398 L 200,369 Z"
                      Fill="#0D6F9D" Stroke="#9DEEFF" StrokeThickness="3"/>
                <Path Data="M 115,389 L 86,441 M 331,389 L 360,441"
                      Stroke="#27BDEB" StrokeThickness="10" StrokeStartLineCap="Round" Fill="Transparent"/>
                <Path Data="M 135,436 L 310,436" Stroke="#9DEEFF" StrokeThickness="2" Fill="Transparent"/>
                <Path Data="M 100,78 L 76,58 L 59,78 M 361,250 L 389,271 L 414,250"
                      Stroke="#36BFEF" StrokeThickness="3" Fill="Transparent"/>
            </Canvas>

            <StackPanel Grid.Column="0" Margin="28,38,0,0" VerticalAlignment="Top"
                        MaxWidth="480">
                <TextBlock Text="ДОБРО ПОЖАЛОВАТЬ В ASTER!" FontSize="11"
                           Foreground="#53D8FF" FontWeight="Bold"/>
                <TextBlock Text="Добро пожаловать в ASTER!"
                           FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,12,0,8" Foreground="#F0FAFF"/>
                <TextBlock Text="Ваш личный AI-помощник&#10;для работы, творчества и игр"
                           FontSize="16" Foreground="#B5D7E8" LineHeight="23"/>
                <Border Background="#102E46" BorderBrush="#1D719C" BorderThickness="1"
                        CornerRadius="12" Padding="12,9" Margin="0,24,0,0"
                        HorizontalAlignment="Left">
                    <TextBlock Text="✦  Спрашивайте, создавайте, исследуйте…" FontSize="12"
                               Foreground="#C9F3FF"/>
                </Border>
            </StackPanel>

            <ListBox x:Name="MessagesList" Grid.Column="0" Grid.ColumnSpan="2"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single" Margin="20,12,18,12">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#10283A" BorderBrush="#1C5877" BorderThickness="1"
                                CornerRadius="11" Padding="12" Margin="0,8,0,8"
                                HorizontalAlignment="Left" MaxWidth="820">
                            <StackPanel>
                                <TextBlock Text="{Binding Author}" FontSize="10"
                                           Foreground="#55D8FF" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                           FontSize="14" LineHeight="21" Margin="0,5,0,0"
                                           Foreground="#EAF7FC"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Text="Готов к работе с локальной моделью."
                   FontSize="10" Foreground="#91AFC4" Margin="4,9,4,7"/>
        <TextBlock x:Name="AttachmentsText" Grid.Row="3" Text="" FontSize="10"
                   Foreground="#91AFC4" TextTrimming="CharacterEllipsis" Margin="4,0,4,6"/>

        <StackPanel Grid.Row="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AttachButton" Grid.Column="0" Content="＋" FontSize="22"
                        Width="42" Height="44" Margin="0,0,8,0"
                        Background="#12344B" Foreground="#8DEAFF" BorderBrush="#23779D"
                        Click="Attach_Click" PreviewMouseRightButtonDown="AttachButton_Clear"
                        ToolTip="Добавить файлы и папки"/>
                <Border Grid.Column="1" Background="#0E2639" BorderBrush="#1E7196"
                        BorderThickness="1" CornerRadius="14" Padding="5">
                    <TextBox x:Name="MessageInput" MinHeight="42" MaxHeight="110"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="10,7"
                             Background="Transparent" Foreground="#EAF7FC"
                             BorderThickness="0" FontSize="13"
                             VerticalContentAlignment="Center"
                             KeyDown="MessageInput_KeyDown"/>
                </Border>
                <Button x:Name="SendButton" Grid.Column="2" Content="➤" FontSize="20"
                        Width="44" Height="44" Margin="8,0,0,0" Padding="0"
                        Background="#0E9FCB" Foreground="#FFFFFF"
                        BorderBrush="#38D5FF" FontWeight="SemiBold" Click="Send_Click"
                        ToolTip="Отправить сообщение"/>
            </Grid>
            <UniformGrid Columns="5" Margin="0,9,0,0">
                <Button Content="♧&#10;Анализ" Tag="Проанализируй мою задачу и предложи план действий." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="⚒&#10;Создание" Tag="Помоги создать новый проект. Предложи структуру и этапы." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="◇&#10;Помощь" Tag="Помоги мне разобраться с задачей пошагово." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="✧&#10;Идеи" Tag="Предложи несколько интересных идей для моей задачи." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
                <Button Content="⌘&#10;Код" Tag="Помоги написать или объяснить код. Сначала уточни задачу." Click="QuickAction_Click" Margin="2" Padding="5,6" FontSize="11" Background="#102A3E" BorderBrush="#1C668A"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>